# JWT HS256 interno Next -> FastAPI. Deve bater com services/ai INTERNAL_JWT_SECRET.
INTERNAL_JWT_SECRET=change-me

# URL base do servico FastAPI.
AI_SERVICE_URL=http://localhost:8000

# Cut-over server-side de /api/tcc/[id]/ai-action para FastAPI quando true.
USE_FASTAPI_ACTIONS=false

# PostHog client-side analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
